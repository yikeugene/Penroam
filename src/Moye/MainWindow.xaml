          <TextBlock Text="{loc:Loc Shell.EraserSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="{loc:Loc Shell.EraserChoiceHint}" FontSize="12" Foreground="#65736D" Margin="0,0,0,14"/>
          <Button x:Name="PointEraseOption" Click="EraserOptionClick" Tag="PointEraser" MinHeight="78" Padding="12,10" Margin="0,0,0,8" AutomationProperties.Name="{loc:Loc Shell.PixelEraser}" ToolTip="{loc:Loc Shell.PixelEraserDetailHint}">
            <StackPanel Width="260"><TextBlock Text="{loc:Loc Shell.PixelEraser}" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Shell.PixelEraserDetail}" TextWrapping="Wrap" FontSize="12" Foreground="#52655B" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="StrokeEraseOption" Click="EraserOptionClick" Tag="StrokeEraser" MinHeight="78" Padding="12,10" Margin="0" AutomationProperties.Name="{loc:Loc Shell.StrokeEraser}" ToolTip="{loc:Loc Shell.StrokeEraserDetailHint}">
            <StackPanel Width="260"><TextBlock Text="{loc:Loc Shell.StrokeEraser}" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Shell.StrokeEraserDetail}" TextWrapping="Wrap" FontSize="12" Foreground="#52655B" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <TextBlock Text="{loc:Loc Shell.EraserSizeLabel}" Foreground="#65736D" FontSize="12" Margin="0,12,0,0"/>
          <Slider x:Name="EraserSizeSlider" Minimum="12" Maximum="120" Value="20" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="EraserSettingsChanged" MinHeight="44" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc Shell.EraserSize}"/>
          <CheckBox x:Name="HighlightOnlyToggle" Content="{loc:Loc Shell.EraseHighlighterOnly}" Checked="EraserSettingsChanged" Unchecked="EraserSettingsChanged" MinHeight="44" VerticalContentAlignment="Center"/>
          <TextBlock Text="{loc:Loc Shell.EraserRememberHint}" TextWrapping="Wrap" FontSize="11" Foreground="#65736D" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="PaperSettingsPopup" PlacementTarget="{Binding ElementName=Viewport}" Placement="Center" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="White" BorderBrush="#DDE3DC" BorderThickness="1" CornerRadius="12" Padding="22" Width="500">
        <StackPanel>
          <TextBlock x:Name="PaperPickerTitle" Text="{loc:Loc Shell.ChoosePaper}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="PaperPickerHint" Text="{loc:Loc Shell.ChoosePaperHint}" TextWrapping="Wrap" Foreground="#65736D" Margin="0,6,0,18"/>
          <controls:PaperTemplatePicker x:Name="TemplatePicker"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Shell.Cancel}" Click="CancelPaperClick"/>
            <Button x:Name="ApplyPaperButton" Content="{loc:Loc Shell.ApplyPaper}" Click="ApplyPaperClick" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
  <Grid x:Name="LibraryHome" Background="#F5F4F0" Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanInteract}" AllowDrop="True" PreviewDragOver="LibraryFolderDragOver" PreviewDrop="LibraryFolderDrop">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DDE3DC" BorderThickness="0,0,0,1">
      <Grid MinHeight="84" Margin="28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{loc:Loc Shell.Logo}">
            <Border.Background><ImageBrush ImageSource="/Penroam;component/Assets/Penroam.png" Stretch="Uniform"/></Border.Background>
          </Border>
          <StackPanel><TextBlock Text="Penroam" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Shell.Tagline}" FontSize="12" Foreground="#65736D"/></StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="RecoveryAlertButton" Content="{loc:Loc Shell.RecoverDrafts}" Click="SafetyCenterClick" Visibility="Collapsed" VerticalAlignment="Center"/>
          <Button x:Name="WorkspaceStateButton" Content="{loc:Loc Core.Workspace}" Click="WorkspaceSettingsClick" MinHeight="44" AutomationProperties.Name="{loc:Loc Controls.Workspace.Title}"/>
          <Button x:Name="HomeBackupButton" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Core.CommandRecovery}" Click="SafetyCenterClick" ToolTip="{loc:Loc Features.BackUpNotebooksRestoreBackupsAndRecoverDrafts}" AutomationProperties.Name="{loc:Loc Features.BackupAndRecovery}"/>
          <Button x:Name="HomeUpdatesButton" Content="{loc:Loc Core.CommandCheckUpdates}" Click="CheckForUpdatesClick" AutomationProperties.Name="{loc:Loc Core.CommandCheckUpdates}"/>
          <Button x:Name="HomeAllToolsButton" Style="{StaticResource TonalButton}" Content="{loc:Loc Features.AllTools}" Click="ShowCommandsClick" ToolTip="{loc:Loc Features.BrowseOrSearchEveryToolCtrlShiftP}" AutomationProperties.Name="{loc:Loc Features.AllTools}"/>
          <ComboBox x:Name="HomeLanguageSelector" SelectedValuePath="Tag" SelectionChanged="HomeLanguageChanged" MinHeight="44" MinWidth="124" Margin="4,2" VerticalContentAlignment="Center" AutomationProperties.Name="Language / 語言" ToolTip="Language / 語言"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="zh-TW" Content="繁體中文"/></ComboBox>
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="40,20,40,0" MaxWidth="1180">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="84"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{loc:Loc Shell.YourNotebooks}" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Shell.LibraryCreateHint}" FontSize="15" Foreground="#65736D" Margin="0,8,20,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HomeRestoreBackupButton" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Shell.RestoreBackup}" Click="RestoreSelectedClick" Foreground="#52655B" Padding="16,8" Margin="0,0,10,0"/>
          <Button x:Name="HomeImportFolderButton" Click="ImportFolderClick" Style="{StaticResource SecondaryButton}" Padding="16,12" Margin="0,0,10,0" AutomationProperties.Name="{loc:Loc Core.CommandImportFolder}" ToolTip="{loc:Loc Shell.ImportFolderHint}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.ImportFolderShort}" Margin="10,0,0,0" FontWeight="SemiBold"/></StackPanel>
          </Button>
          <Button x:Name="HomeNewNotebookButton" Click="NewNoteClick" Style="{StaticResource PrimaryButton}" Padding="20,12" AutomationProperties.Name="{loc:Loc Shell.NewNotebook}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.NewNotebookShort}" Margin="10,0,0,0" FontWeight="SemiBold"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,22,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid MaxWidth="460" HorizontalAlignment="Left" Width="460">
          <TextBox x:Name="HomeSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="40,8,52,8" AutomationProperties.Name="{loc:Loc Shell.SearchNotebooks}" ToolTip="{loc:Loc Shell.HomeSearchHint}"/>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#65736D" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBlock Text="{loc:Loc Shell.SearchTitleCategory}" Foreground="#65736D" Margin="42,0,50,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Button Style="{StaticResource IconButton}" x:Name="ClearHomeSearchButton" Click="ClearSearchClick" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="44" Margin="0,0,2,0" HorizontalAlignment="Right" ToolTip="{loc:Loc Shell.ClearSearch}" AutomationProperties.Name="{loc:Loc Shell.ClearSearch}" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ContinueLastButton" Content="{loc:Loc Shell.Continue}" Click="ContinueLastClick" MinHeight="44"/><Button Content="{loc:Loc Shell.QuickNote}" Click="QuickNoteClick" MinHeight="44"/><Button Content="{loc:Loc Shell.FindContent}" Click="SearchContentsClick" MinHeight="44"/></StackPanel>
      </Grid>
      <Grid Grid.Row="2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Loc Shell.AllNotebooks}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding LibraryCountText}" Margin="16,0,0,0" Foreground="#65736D" FontSize="13" AutomationProperties.LiveSetting="Polite"/></StackPanel>
        <Button Content="{loc:Loc Shell.SortFilter}" Click="LibraryOrganizationClick" HorizontalAlignment="Right" FontSize="12" MinHeight="44"/>
      </Grid>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="{Binding HasVisibleNotebooks, Converter={StaticResource BoolVisibility}}">
        <ItemsControl x:Name="HomeNotebookCards" ItemsSource="{Binding Notebooks}" AlternationCount="4" Margin="0,4,0,24">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border x:Name="NotebookCard" Tag="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Width="264" Margin="0,8,20,20" Background="White" BorderThickness="1" CornerRadius="12">
              <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#A4B6A9"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
              <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                <Button Style="{StaticResource NotebookOpenButton}" Click="OpenNotebookClick" Margin="0" Padding="14,14,14,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                  <StackPanel Width="230">
                    <Border x:Name="NotebookCover" Height="136" CornerRadius="5,10,10,5" Margin="0,0,0,16" Background="{Binding DisplayCoverColor}">
                      <Grid>
                        <Border Width="9" Background="#25000000" HorizontalAlignment="Left" CornerRadius="5,0,0,5"/>
                        <Border Width="1" Background="#30FFFFFF" HorizontalAlignment="Left" Margin="13,0,0,0"/>
                        <Grid Margin="30,20,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <TextBlock Text="{loc:Loc Shell.Pinned}" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                          <Path Data="M2,1 L16,1 Q18,1 18,3 L18,22 4,22 Q1,22 1,19 L1,4 Q1,1 2,1 M5,1 L5,18 M1,19 Q2,18 4,18 L18,18" Stroke="#E4EEE7" StrokeThickness="1.4" Width="22" Height="26" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                          <StackPanel Grid.Row="1"><TextBlock Text="{Binding Folder}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Width="28" Height="2" Background="#90FFFFFF" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Height="50" LineHeight="25" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Folder}" FontSize="13" Foreground="#65736D" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
                <Grid Grid.Row="1" Margin="16,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{loc:Format Shell.PageCount, SingularKey=Shell.SinglePageCount, Value={Binding PageCount}}" FontSize="12" Foreground="#65736D" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource SecondaryButton}" Grid.Column="1" x:Name="NotebookOptionsButton" Content="{loc:Loc Features.NotebookActions}" Click="MoreClick" FontSize="12" Padding="9,6" MinHeight="44" Margin="6,0,0,0" ToolTip="{loc:Loc Features.OpenPinChangeTheCoverOrDeleteThis}" AutomationProperties.Name="{loc:Format Features.NotebookActionsName, Value={Binding Title}}">
                    <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{loc:Loc Shell.OpenNotebook}" Click="OpenNotebookMenuClick"/><MenuItem Header="{loc:Loc Shell.TogglePin}" Click="TogglePinNotebookClick"/><MenuItem Header="{loc:Loc Shell.ChooseCoverColor}" Click="EditNotebookAppearanceClick"/><Separator/><MenuItem Header="{loc:Loc Shell.DeleteNotebookMenu}" Click="DeleteNotebookFromCardClick"/></ContextMenu></Button.ContextMenu>
                  </Button>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,38" MaxWidth="440">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleNotebooks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Border Width="76" Height="76" Background="#E7F0EA" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,22"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <TextBlock Text="{Binding EmptyLibraryTitle}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
        <TextBlock Text="{Binding EmptyLibraryDescription}" Foreground="#65736D" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,24"/>
        <Button x:Name="EmptyLibraryClearSearchButton" Content="{loc:Loc Shell.ClearSearch}" Click="ClearSearchClick" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Padding="24,10" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"/>
        <Button x:Name="EmptyLibraryCreateButton" Content="{loc:Loc Shell.CreateFirstNotebook}" Click="NewNoteClick" HorizontalAlignment="Center" Padding="24,10"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasSearch}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="40,0" MaxWidth="1180"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Foreground="#65736D" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.LibraryFooter}" Foreground="#65736D" FontSize="12" Margin="8,0,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" Foreground="#65736D" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400"/></Grid>
  </Grid>
  <Border x:Name="BusyOverlay" Background="#EDF5F4F0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
    <Border Background="White" BorderBrush="#DDE3DC" BorderThickness="1" CornerRadius="16" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24">
      <StackPanel><ProgressBar IsIndeterminate="True" Width="240" Height="4" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Operation}" Margin="0,22,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/><Button Style="{StaticResource SecondaryButton}" x:Name="CancelDocumentImportButton" Content="{loc:Loc Shell.CancelImport}" Click="CancelDocumentImportClick" Visibility="Collapsed" HorizontalAlignment="Center" MinWidth="140" Margin="0,20,0,0" ToolTip="{loc:Loc Shell.CancelImportHint}"/></StackPanel>
    </Border>
  </Border>
  <controls:UpdateNotification x:Name="UpdateNotice" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed"/>
  </Grid>
</Window>
