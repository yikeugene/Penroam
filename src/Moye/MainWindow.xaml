<Window x:Class="Moye.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Moye.Controls" xmlns:vm="clr-namespace:Moye.ViewModels" xmlns:loc="clr-namespace:Moye.Localization"
        Title="{loc:Loc Shell.WindowTitle}" Icon="/Penroam;component/Assets/Penroam.ico" Width="1400" Height="960" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" PreviewKeyUp="WindowKeyUp" Deactivated="WindowDeactivated"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Language="en-US">
  <Window.Resources>
    <Style x:Key="ToolIcon" TargetType="Path">
      <Setter Property="Width" Value="23"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="1.6"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>
    <Style x:Key="ToolLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style x:Key="FocusToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Width" Value="50"/><Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="6"/>
    </Style>
    <Style x:Key="FocusActionButton" TargetType="Button" BasedOn="{StaticResource FocusToolButton}">
      <Setter Property="Width" Value="104"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FloatingCircleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Circle" CornerRadius="26" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="92"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#65736D"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FeatureCategoryItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="44"/>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <DataTemplate x:Key="EditablePageTemplate">
      <StackPanel>
        <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="White" Loaded="PageHostLoaded" Unloaded="PageHostUnloaded" DataContextChanged="PageHostDataContextChanged" PreviewMouseDown="PageHostMouseDown" PreviewStylusDown="PageHostStylusDown" ContextMenuOpening="PageContextMenuOpening"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.13" Color="#6C788E"/></Border.Effect></Border>
        <TextBlock Text="{Binding Number, StringFormat={}—  {0}  —}" HorizontalAlignment="Center" FontSize="11" Foreground="#65736D" Margin="0,14,0,0" IsHitTestVisible="False"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <Grid x:Name="EditorShell" Background="#ECEEE8" Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanInteract}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- The open notebook is the top-level navigation; writing tools stay secondary. -->
    <Border x:Name="NotebookHeader" Height="Auto" Background="White" BorderBrush="#DDE3DC" BorderThickness="0,0,0,1" IsEnabled="{Binding CanInteract}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="44"/></Grid.RowDefinitions>
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Click="ShowNotebooksClick" HorizontalAlignment="Left" ToolTip="{loc:Loc Shell.OpenNotebooksHint}" AutomationProperties.Name="{loc:Loc Features.Command.open-notebooks.Name}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><Path Data="M4,2 L20,2 Q22,2 22,4 L22,23 5,23 Q2,23 2,20 L2,5 Q2,2 4,2 M6,2 L6,18 M2,19 Q3,18 5,18 L22,18 M10,7 L18,7 M10,11 L16,11" Style="{StaticResource ToolIcon}" Width="19" Height="21"/><TextBlock Text="{loc:Loc Features.Command.open-notebooks.Name}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/></StackPanel>
          </Button>
          <Button Grid.Column="1" Click="RenameClick" ToolTip="{loc:Loc Shell.RenameCategoryHint}" MaxWidth="540" Padding="12,5" Margin="8,0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:Format Features.RenameNotebookName, Value={Binding Title}}">
            <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding SelectedSectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSectionTitle}" Foreground="#65736D" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
          </Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ManagePagesButton" Style="{StaticResource HeaderActionButton}" Content="{loc:Loc Core.CommandManagePages}" Click="ManagePagesClick" ToolTip="{loc:Loc Features.ReorderMoveCopyOrDeletePages}" AutomationProperties.Name="{loc:Loc Core.CommandManagePages}"/>
            <Button x:Name="TwoPagesButton" Style="{StaticResource HeaderActionButton}" Content="{loc:Loc Features.Command.two-pages.Name}" Click="ToggleTwoPagesClick" ToolTip="{loc:Loc Features.SwitchBetweenSinglePageAndEditableTwoPage}" AutomationProperties.Name="{loc:Loc Features.Command.two-pages.Name}"/>
            <Button x:Name="ReferenceViewButton" Style="{StaticResource HeaderActionButton}" Content="{loc:Loc Controls.Reference.Title}" Click="ShowReferenceClick" ToolTip="{loc:Loc Features.OpenAPageBesideYourWritingAsA}" AutomationProperties.Name="{loc:Loc Features.Command.reference-view.Name}"/>
            <Button Style="{StaticResource TonalButton}" Click="ExportDocumentWorkflowClick" Padding="10,8" FontSize="12" ToolTip="{loc:Loc Shell.ExportPdfHint}" AutomationProperties.Name="{loc:Loc Core.CommandExportPdf}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.Export}" Margin="8,0,0,0"/></StackPanel></Button>
            <Button x:Name="AllToolsButton" Style="{StaticResource HeaderActionButton}" Content="{loc:Loc Features.AllTools}" Click="ShowCommandsClick" ToolTip="{loc:Loc Features.BrowseOrSearchEveryToolCtrlShiftP}" AutomationProperties.Name="{loc:Loc Features.AllTools}"/>
          </StackPanel>
        </Grid>
        <Menu x:Name="FeatureMenu" Grid.Row="1" Height="44" Margin="16,0" Padding="0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FeatureCategoryItem}" AutomationProperties.Name="{loc:Loc Features.NotebookFeatures}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="#FAFBF8" BorderBrush="#DDE3DC" BorderThickness="0,0,1,0" IsEnabled="{Binding CanInteract}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
          <Border Margin="14,9" Padding="4" Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="{loc:Loc Shell.Contents}" Click="SidebarTabClick" x:Name="PagesTab" Tag="Pages" Style="{StaticResource SidebarTab}" Background="White" Foreground="{StaticResource Accent}"/>
              <Button Content="{loc:Loc Shell.Notebooks}" Click="SidebarTabClick" x:Name="NotebooksTab" Tag="Notebooks" Style="{StaticResource SidebarTab}"/>
            </StackPanel>
          </Border>
          <Grid x:Name="PagesPanel" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
            <StackPanel Margin="12,0,12,8">
              <DockPanel>
                <Button Style="{StaticResource IconButton}" x:Name="AddSectionButton" DockPanel.Dock="Right" Content="&#xE710;" Click="AddSectionClick" ToolTip="{loc:Loc Shell.AddSectionHint}" AutomationProperties.Name="{loc:Loc Shell.AddSection}"/>
                <Button Style="{StaticResource SecondaryButton}" x:Name="SectionOptionsButton" Content="{loc:Loc Features.Command.section-actions.Name}" Click="SectionOptionsClick" ContextMenuOpening="SectionContextMenuOpening" Padding="10,6" FontSize="12" Margin="0,0,6,0" ToolTip="{loc:Loc Features.RenameMoveOrOrganizeThisSectionYouCan}" AutomationProperties.Name="{loc:Loc Features.Command.section-actions.Name}"/>
              </DockPanel>
              <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=OneWay}" SelectionChanged="SectionSelectionChanged" MaxHeight="112" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Shell.NotebookSections}">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                  <Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,2"/>
                  <Setter Property="ToolTip" Value="{loc:Loc Shell.SectionContextHint}"/>
                  <EventSetter Event="PreviewMouseRightButtonDown" Handler="SectionRightButtonDown"/>
                  <EventSetter Event="ContextMenuOpening" Handler="SectionContextMenuOpening"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SectionRow" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SectionRow" Property="Background" Value="#EEF2EC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SectionRow" Property="Background" Value="#E7F0EA"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SectionRow" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="SectionRow" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{loc:Format Shell.PageCount, Value={Binding PageCount}, SingularKey=Shell.SinglePageCount}" FontSize="12" Foreground="#65736D" Margin="0,2,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="20,0,12,0">
              <Button x:Name="PageActionsButton" DockPanel.Dock="Right" Content="{loc:Loc Features.Command.page-actions.Name}" Click="PageActionsClick" Padding="8,6" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{loc:Loc Features.ActionsForTheSelectedPage}" AutomationProperties.Name="{loc:Loc Features.Command.page-actions.Name}"/>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedSectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSectionTitle}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding SectionPageCountText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SectionPageCountText}" Foreground="#65736D" FontSize="12" Margin="0,2,0,0"/></StackPanel>
            </DockPanel>
            <ListBox Grid.Row="2" x:Name="ThumbnailList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="ThumbnailSelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Margin="6,0" AutomationProperties.Name="{loc:Loc Shell.PageThumbnails}">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,4,0,14"/>
                <Setter Property="ToolTip" Value="{loc:Loc Shell.PageContextHint}"/>
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThumbnailRightButtonDown"/>
                <EventSetter Event="ContextMenuOpening" Handler="PageContextMenuOpening"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="ThumbSelection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="8,8,8,6" Background="Transparent"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSelection" Property="Background" Value="#EEF2EC"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ThumbSelection" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="ThumbSelection" Property="Background" Value="#E7F0EA"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ThumbSelection" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel Loaded="ThumbnailLoaded">
                <Border Background="White" BorderBrush="#DDE3DC" BorderThickness="1" Width="128" Height="174"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" Foreground="#52655B" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button AutomationProperties.Name="{loc:Loc Shell.AddPage}" Click="AddPageClick" Grid.Row="3" Margin="22,6,22,10" Background="White" BorderThickness="1" BorderBrush="#DDE3DC" Foreground="{StaticResource Accent}" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.AddPage}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
          </Grid>
          <Grid x:Name="NotebooksPanel" Grid.Row="1" Visibility="Collapsed" Margin="12,0">
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <TextBox x:Name="LibrarySearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Shell.SearchTitleCategory}" AutomationProperties.Name="{loc:Loc Shell.SearchNotebooks}" Padding="32,8,46,8" Background="White"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#65736D" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Text="{loc:Loc Shell.FindNotebook}" Foreground="#65736D" Margin="34,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <Button Style="{StaticResource IconButton}" x:Name="ClearSidebarSearchButton" Click="ClearSearchClick" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="44" Margin="0,0,1,0" HorizontalAlignment="Right" ToolTip="{loc:Loc Shell.ClearSearch}" AutomationProperties.Name="{loc:Loc Shell.ClearSearch}" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Notebooks}" x:Name="NotebookList" SelectionChanged="NotebookSelectionChanged" AutomationProperties.Name="{loc:Loc Shell.Notebooks}">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NoteRow" CornerRadius="8" Padding="9,11" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NoteRow" Property="Background" Value="#EEF2EC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="NoteRow" Property="Background" Value="#E7F0EA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NoteRow" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="35" Height="47" Background="#3B6656" CornerRadius="2,5,5,2" HorizontalAlignment="Left"><Grid><Border Width="4" HorizontalAlignment="Left" Background="#2A4E40"/><StackPanel Margin="10,12,7,0"><Rectangle Height="2" Fill="#DDE6F6"/><Rectangle Height="2" Fill="#B7C7DF" Margin="0,5,7,0"/></StackPanel></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#65736D" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{loc:Format Shell.PageCount, Value={Binding PageCount}, SingularKey=Shell.SinglePageCount}" FontSize="12" Foreground="#65736D" Margin="0,3,0,0"/></StackPanel>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notebooks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{loc:Loc Shell.NoMatchingNotebooks}" Foreground="#65736D" FontSize="12"/><Button x:Name="SidebarClearSearchButton" Content="{loc:Loc Shell.ClearSearch}" Click="ClearSearchClick" Foreground="{StaticResource Accent}" Margin="0,12,0,0" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"/></StackPanel>
            <Button AutomationProperties.Name="{loc:Loc Shell.NewNotebook}" Click="NewNoteClick" Grid.Row="2" Margin="10,6,10,10" Background="White" BorderThickness="1" BorderBrush="#DDE3DC" Foreground="{StaticResource Accent}" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.NewNotebook}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Foreground="#65736D" VerticalAlignment="Center"/><TextBlock Text="{loc:Loc Shell.OfflineWorkspace}" Foreground="#65736D" FontSize="12" Margin="8,0,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="WritingHeader" Background="White" BorderBrush="#DDE3DC" BorderThickness="0,0,0,1" IsEnabled="{Binding CanInteract}">
          <StackPanel>
          <Grid Margin="12,0" Height="72">
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE8A0;" Click="ToggleSidebarClick" FontFamily="Segoe Fluent Icons" FontSize="18" ToolTip="{loc:Loc Shell.SidebarToggleHint}" AutomationProperties.Name="{loc:Loc Shell.SidebarToggle}"/>
            <StackPanel x:Name="WritingTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button x:Name="PenButton" Tag="Pen" Style="{StaticResource ToolButton}" Click="ToolClick" ToolTip="{loc:Loc Shell.PenPressureHint}" AutomationProperties.Name="{loc:Loc Shell.Pen}"><StackPanel><Path Data="M16,2 L22,8 10,20 3,22 5,15 Z M5,15 L10,20 M14,4 L20,10" Style="{StaticResource ToolIcon}"/><TextBlock Text="{loc:Loc Shell.Pen}" Style="{StaticResource ToolLabel}"/></StackPanel></Button>
<Button x:Name="HighlighterButton" Width="80" Tag="Highlighter" Style="{StaticResource ToolButton}" Click="ToolClick" ToolTip="{loc:Loc Shell.HighlighterHint}" AutomationProperties.Name="{loc:Loc Shell.Highlighter}"><StackPanel><Path Data="M12,3 L21,8 14,19 5,14 Z M7,15 L5,19 10,21 12,18 M3,23 L13,23 M10,6 L18,11" Style="{StaticResource ToolIcon}"/><TextBlock Text="{loc:Loc Shell.Highlighter}" Style="{StaticResource ToolLabel}"/></StackPanel></Button>
<Button x:Name="EraserButton" Tag="PointEraser" Style="{StaticResource ToolButton}" Click="EraserToolClick" ToolTip="{loc:Loc Shell.PixelEraserHint}" AutomationProperties.Name="{loc:Loc Shell.Eraser}"><StackPanel><Path Data="M13,3 Q14,2 15,3 L22,10 Q23,11 22,12 L12,22 7,22 2,17 Q1,16 2,15 Z M7,10 L17,17 M12,22 L23,22" Style="{StaticResource ToolIcon}"/><TextBlock x:Name="EraserModeLabel" Text="{loc:Loc Shell.Eraser}" Style="{StaticResource ToolLabel}"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc Shell.PixelEraser}" Click="EraserMenuClick" Tag="PointEraser"/><MenuItem Header="{loc:Loc Shell.StrokeEraser}" Click="EraserMenuClick" Tag="StrokeEraser"/></ContextMenu></Button.ContextMenu></Button>
<Button x:Name="LassoButton" Tag="Lasso" Style="{StaticResource ToolButton}" Click="ToolClick" ToolTip="{loc:Loc Shell.LassoClipboardHint}" AutomationProperties.Name="{loc:Loc Shell.Lasso}"><StackPanel><Path Data="M8,20 C-1,17 0,4 12,3 C24,1 27,16 15,20 C8,23 4,21 6,17 C8,13 12,21 8,25" Style="{StaticResource ToolIcon}"/><TextBlock Text="{loc:Loc Shell.Lasso}" Style="{StaticResource ToolLabel}"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc Shell.CopySelection}" InputGestureText="Ctrl+C" Click="CopyInkClick"/><MenuItem Header="{loc:Loc Shell.CutSelection}" InputGestureText="Ctrl+X" Click="CutInkClick"/><MenuItem Header="{loc:Loc Shell.Paste}" InputGestureText="Ctrl+V" Click="PasteContentClick"/></ContextMenu></Button.ContextMenu></Button>
<Button x:Name="TypeButton" Tag="Text" Style="{StaticResource ToolButton}" Click="TypeClick" ToolTip="{loc:Loc Shell.TypeHint}" AutomationProperties.Name="{loc:Loc Shell.Type}"><StackPanel><Path Data="M3,7 L3,3 23,3 23,7 M13,3 L13,23 M8,23 L18,23" Style="{StaticResource ToolIcon}"/><TextBlock Text="{loc:Loc Shell.Type}" Style="{StaticResource ToolLabel}"/></StackPanel></Button>
<Button x:Name="SelectButton" Tag="Select" Style="{StaticResource ToolButton}" Click="ToolClick" ToolTip="{loc:Loc Shell.SelectHint}" AutomationProperties.Name="{loc:Loc Shell.Select}"><StackPanel><Path Data="M4,2 L4,21 9,16 13,24 17,22 13,14 21,13 Z" Style="{StaticResource ToolIcon}"/><TextBlock Text="{loc:Loc Shell.Select}" Style="{StaticResource ToolLabel}"/></StackPanel></Button>
              <Border Width="1" Height="28" Background="#DDE3DC" Margin="7,0"/>
              <Button Style="{StaticResource SecondaryButton}" x:Name="PenSettingsButton" Click="PenSettingsClick" ToolTip="{loc:Loc Features.PenSettingsColorThicknessAndSavedPens}" AutomationProperties.Name="{loc:Loc Features.PenSettings}" Padding="10,6" Background="#F0F3ED">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{loc:Loc Features.PenSettings}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,4,4"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="CurrentColor" Width="16" Height="16" Fill="#25334A"/><TextBlock x:Name="CurrentWidth" Text="2.5" Margin="8,0,5,0" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="mm" FontSize="11" Foreground="#65736D" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#65736D" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="UndoClick" FontFamily="Segoe Fluent Icons" FontSize="18" IsEnabled="{Binding CanUndo}" ToolTip="{loc:Loc Shell.UndoHint}" AutomationProperties.Name="{loc:Loc Shell.Undo}"/>
              <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="RedoClick" FontFamily="Segoe Fluent Icons" FontSize="18" IsEnabled="{Binding CanRedo}" ToolTip="{loc:Loc Shell.RedoHint}" AutomationProperties.Name="{loc:Loc Shell.Redo}"/>
